{
  "manifest_version": 3,
  "name": "HandWave Browser Controller",
  "version": "1.0.0",
  "description": "Free hand-gesture browser controller using camera. No API keys. Works on every site.",
  "permissions": [
    "tabs",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "lib/*",
        "keyboard.html",
        "keyboard.js",
        "keyboard.css"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
